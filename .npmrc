# Use this config to upload a package to npmjs for the first time. 
# Make sure you have an env variable with name NPM_TOKEN and value equal to a token with publish permission.

# @uipath:registry=https://registry.npmjs.org
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}


# Use this config when you're using private packages for testing.
# legacy-peer-deps=true
# @uipath:registry=https://npm.pkg.github.com/
# //npm.pkg.github.com/:_authToken=${GH_NPM_REGISTRY_TOKEN}
