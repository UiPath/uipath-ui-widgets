{
  "name": "@uipath/ui-widgets-conversational-agent-chat",
  "version": "1.0.0",
  "description": "A React conversational agent chat component",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ConversationalAgentChat.css": "./dist/ConversationalAgentChat.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-styles",
    "clean": "rimraf dist",
    "copy-styles": "sass --no-source-map src/ConversationalAgentChat.scss | postcss -o dist/ConversationalAgentChat.css",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage --run"
  },
  "keywords": [
    "react",
    "chat",
    "conversational-agent",
    "ui-widgets"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UiPath/uipath-ui-widgets.git",
    "directory": "packages/conversational-agent-chat"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@uipath/uipath-typescript": "npm:@uipath/uipath-typescript-dev@^1.0.0-beta.1"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "jsdom": "^25.0.1",
    "sass-embedded": "^1.93.3",
    "typescript": "~5.9.3",
    "vite": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@uipath/apollo-react": "^3.30.2",
    "@uipath/apollo-core": "^5.7.0",
    "@uipath/apollo-wind": "^0.10.0"
  }
}
