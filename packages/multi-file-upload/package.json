{
  "name": "@uipath/ui-widgets-multi-file-upload",
  "version": "1.0.2",
  "description": "A React multi-file upload component",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./MultiFileUpload.css": "./dist/MultiFileUpload.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-styles",
    "clean": "rm -rf dist",
    "copy-styles": "npx sass --no-source-map src/MultiFileUpload.scss | npx postcss -o dist/MultiFileUpload.css"
  },
  "keywords": [
    "react",
    "multi-file-upload",
    "upload",
    "ui-widgets"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.9.3",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1"
  },
  "dependencies": {
    "@uipath/apollo-core": "^5.5.0",
    "@uipath/apollo-wind": "^0.6.3",
    "@uipath/uipath-typescript": "^1.0.0-beta.16"
  }
}
