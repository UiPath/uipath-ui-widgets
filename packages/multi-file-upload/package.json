{
  "name": "@uipath/ui-widgets-multi-file-upload",
  "version": "1.0.2",
  "description": "A React component for uploading multiple files simultaneously to UiPath Orchestrator Storage Bucket",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./MultiFileUpload.css": "./dist/MultiFileUpload.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-styles",
    "clean": "rimraf dist",
    "copy-styles": "sass --no-source-map src/MultiFileUpload.scss | postcss -o dist/MultiFileUpload.css",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage --run"
  },
  "keywords": [
    "react",
    "multi-file-upload",
    "upload",
    "tailwind",
    "tailwindcss",
    "ui"
  ],
  "author": "UiPath",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UiPath/uipath-ui-widgets.git",
    "directory": "packages/multi-file-upload"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bugs": {
    "url": "https://github.com/UiPath/uipath-ui-widgets/issues"
  },
  "homepage": "https://uipath.github.io/uipath-ui-widgets/?path=/docs/components-multifileupload--docs",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@uipath/uipath-typescript": "1.0.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "vite": "^6.0.3",
    "vitest": "^4.0.18",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.83.4",
    "lightningcss": "^1.30.2",
    "@tailwindcss/oxide": "^4.1.18",
    "rollup": "^4.55.1"
  },
  "dependencies": {
    "@uipath/apollo-core": "^5.7.0",
    "@uipath/apollo-wind": "^0.10.0"
  }
}
