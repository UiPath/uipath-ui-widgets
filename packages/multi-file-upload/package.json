{
  "name": "@uipath/ui-widgets-multi-file-upload",
  "version": "1.0.2",
  "description": "A React multi-file upload component",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./MultiFileUpload.css": "./dist/MultiFileUpload.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-styles",
    "clean": "rm -rf dist",
    "copy-styles": "npx sass --no-source-map src/MultiFileUpload.scss | npx postcss -o dist/MultiFileUpload.css",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage --run"
  },
  "keywords": [
    "react",
    "multi-file-upload",
    "upload",
    "ui-widgets"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@uipath/uipath-typescript": "npm:@uipath/uipath-typescript-dev@^1.0.0-beta.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.83.4",
    "lightningcss": "^1.30.2",
    "@tailwindcss/oxide": "^4.1.18",
    "rollup": "^4.55.1"
  },
  "dependencies": {
    "@uipath/apollo-core": "^5.6.0",
    "@uipath/apollo-wind": "^0.6.5"
  }
}
