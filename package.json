{
  "name": "uipath-ui-widgets",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/multi-file-upload",
    "packages/datatable",
    "packages/conversational-agent-chat",
    "packages/validation-station"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . && npm run check-i18n",
    "check-i18n": "node scripts/check-i18n-keys.mjs",
    "preview": "rolldown-vite preview",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:ui": "npm run test:ui --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "storybook": "npx storybook dev -p 6006 --config-dir .storybook",
    "build-storybook": "npx storybook build --config-dir .storybook",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.9",
    "@mui/material": "^7.3.5",
    "@uipath/ui-widgets-conversational-agent-chat": "file:./packages/conversational-agent-chat/dist",
    "@uipath/ui-widgets-datatable": "file:./packages/datatable/dist",
    "@uipath/ui-widgets-multi-file-upload": "file:./packages/multi-file-upload/dist",
    "@uipath/ui-widgets-validation-station": "file:./packages/validation-station/dist",
    "@uipath/uipath-typescript": "^1.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "^4.8.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/react-vite": "^10.2.8",
    "@tailwindcss/oxide": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "10.2.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.30.2",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "3.8.1",
    "rimraf": "^6.0.1",
    "sass": "^1.83.4",
    "storybook": "^10.2.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "^4.1.18",
    "@tailwindcss/oxide-darwin-x64": "^4.1.18",
    "@tailwindcss/oxide-linux-arm64-gnu": "^4.1.18",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.18",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.1.18",
    "lightningcss-darwin-arm64": "^1.30.2",
    "lightningcss-darwin-x64": "^1.30.2",
    "lightningcss-linux-arm64-gnu": "^1.30.2",
    "lightningcss-linux-x64-gnu": "^1.30.2",
    "lightningcss-win32-x64-msvc": "^1.30.2"
  }
}
