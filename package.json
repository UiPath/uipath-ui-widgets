{
  "name": "uipath-ui-widgets",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "for dir in packages/*/; do [ -f \"$dir/package.json\" ] && (cd \"$dir\" && npm i && npm run build) || exit 1; done",
    "lint": "eslint .",
    "preview": "rolldown-vite preview",
    "test": "npm test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:ui": "npm run test:ui --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "storybook": "npx storybook dev -p 6006 --config-dir .storybook",
    "build-storybook": "npx storybook build --config-dir .storybook"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.9",
    "@mui/material": "^7.3.5",
    "@uipath/ui-widgets-datatable": "file:./packages/datatable/dist",
    "@uipath/ui-widgets-multi-file-upload": "1.0.2",
    "@uipath/uipath-typescript": "^1.0.0-beta.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "vitest": "^2.1.8",
    "sass": "^1.83.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "storybook": "^10.2.0",
    "@storybook/react-vite": "^10.2.0",
    "lightningcss": "^1.30.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "@tailwindcss/oxide": "^4.1.18",
    "rollup": "^4.55.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.55.1",
    "@rollup/rollup-darwin-x64": "^4.55.1",
    "@rollup/rollup-darwin-arm64": "^4.55.1",
    "@rollup/rollup-win32-x64-msvc": "^4.55.1"
  }
}
